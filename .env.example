# =========================================================================
# PR4Fang AI — Environment Variables Configuration
# =========================================================================

# 1. Application & Port
PORT=3005
NODE_ENV=development

# 2. Supabase Cloud Configuration (PostgreSQL, Storage, Auth)
# Get credentials from https://supabase.com/dashboard/project/<project-id>/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# 3. Security & Authentication
JWT_SECRET=pr4fang_ai_super_secret_jwt_key_2026_community_college_fang

# 4. AI Engine (Gemini)
# Get free API key from https://aistudio.google.com
GEMINI_API_KEY=

# 5. LINE Official Account (Messaging API)
# From https://developers.line.biz/console
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 6. n8n Automation (Optional)
N8N_API_KEY=fang_ai_n8n_live_sec_key_2026
